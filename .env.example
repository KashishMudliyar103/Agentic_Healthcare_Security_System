# Groq API Key (for Explainability Agent + Report Generation)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model
GROQ_MODEL=llama-3.1-8b-instant

# FastAPI Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Security Settings
SECRET_KEY=your_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# HIPAA Audit Log Path
AUDIT_LOG_PATH=./logs/hipaa_audit.jsonl
INCIDENT_REPORT_PATH=./reports/incidents/

# ML Model Paths
MODEL_PATH=./models/saved/
DATA_PATH=./data/

# Risk Thresholds
RISK_THRESHOLD_ALLOW=0.30
RISK_THRESHOLD_RESTRICT=0.55
RISK_THRESHOLD_BLOCK=0.75

# HITL Settings
HITL_TIMEOUT_SECONDS=300
HIGH_PRIVILEGE_ROLES=Doctor,Admin,ChiefMedicalOfficer

# Streamlit
STREAMLIT_PORT=8501
